[Unit]
Description=Platform API (development, 0.0.0.0:9100)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# 改成你 clone 后的实际路径
WorkingDirectory=%h/platform-api
Environment=PLATFORM_SERVE_FRONTEND=false
Environment=PLATFORM_HOST=0.0.0.0
Environment=PLATFORM_PORT=9100
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/platform-api/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 9100
Restart=always
RestartSec=2
TimeoutStopSec=20

# 开发实例只需要写仓库内的 data/ 与日志；其余系统目录只读。
NoNewPrivileges=true

[Install]
WantedBy=default.target
