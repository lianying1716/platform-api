# platform-api 配置样例：复制为 .env（.env 已在 .gitignore，勿提交）

# 监听
PLATFORM_HOST=0.0.0.0
# Docker 下这是宿主机端口；容器内部始终监听 9100。
PLATFORM_PORT=9100

# Compose 项目名（决定数据卷与升级作用域；同机多实例必须各用一个）。
COMPOSE_PROJECT_NAME=platform-api
# 镜像名（fork/私有 registry 可覆盖）。
PLATFORM_IMAGE=ghcr.io/lianying1716/platform-api
PLATFORM_UPDATER_IMAGE=ghcr.io/lianying1716/platform-api-updater

# 是否由后端托管前端正式构建产物（app/static）。
# 开发保持 false：前端走 Vite dev server(:5173)，后端只提供 /api。
# Docker Compose 默认已覆盖为 true，会托管镜像内构建好的网页。
PLATFORM_SERVE_FRONTEND=false


# ---- 版本门禁与升级（详见 docs/upgrade-compatibility.md）----
# 启动时版本落后是否允许自动迁移到 head；只读/演示实例设 false（版本不符即拒启）。
PLATFORM_AUTO_MIGRATE=true
# 逃生开关：允许带"未知 revision"启动，仅供人工排障，正常保持 false。
PLATFORM_ALLOW_UNKNOWN_DB=false
# 本容器是否执行数据库迁移；compose 中 api=true、worker=false（迁移单飞，契约 I2）。
PLATFORM_RUN_MIGRATIONS=true

# ---- 网页一键升级（可选，默认关闭）----
# 留空 = 不启用，前端「版本与升级」不显示升级按钮。
# 启用步骤：
#   1) 生成共享密钥：python -c "import secrets;print(secrets.token_urlsafe(32))"
#   2) 填到下面两行（api 用来调边车、边车用来鉴权，必须是同一个值）
#   3) 用 updater profile 启动：docker compose --profile updater up -d
#   4) 安全提示：updater 容器持有 docker socket（等价 root），只在受信环境启用
PLATFORM_UPDATER_URL=
# 启用时填边车地址（compose 内部名）：http://platform-updater:9200
PLATFORM_UPDATER_TOKEN=

# 检查更新用的 GitHub 仓库（默认本项目）
PLATFORM_UPDATE_REPO=lianying1716/platform-api
# 可选：GitHub 只读 token。未认证 API 按出口 IP 每小时仅 60 次；多实例共用
# NAT 或频繁检查会触发 403 rate limit。公开仓库用无权限 token 即可。
PLATFORM_UPDATE_GITHUB_TOKEN=

# 数据库
# 推荐用结构化字段：密码包含 @ : / 等字符时不需要手工 URL 编码。
# Docker Compose 会使用下面的账号/库名创建 db 服务。
PLATFORM_DB_HOST=db
PLATFORM_DB_PORT=5432
PLATFORM_DB_USER=platform
PLATFORM_DB_PASSWORD=platform
PLATFORM_DB_NAME=platform

# 完整 DSN 是兼容入口（外部数据库或既有部署用）。留空即可使用上面的结构化字段；
# 非 Docker 本地开发可设为 postgresql+psycopg2://platform:platform@127.0.0.1:5433/platform
PLATFORM_DATABASE_URL=

# ---- 存储目录可视化选择 ----
# 网页「系统设置 → 存储目录 → 新增根目录 → 浏览」允许浏览的白名单根（`:` 分隔，Windows 用 `;`）。
# 留空时：容器内只放行 /data（安全默认）；裸机自动列平台默认根（/、/mnt、/Volumes、$HOME 或 Windows 盘符）。
# Docker 下要选到宿主目录：先把宿主目录 bind mount 进 api 与 worker（同一容器内路径），
# 再把容器内挂载点写进这里，例如：
# PLATFORM_BROWSE_ROOTS=/data:/mnt/nas:/mnt/local
# 对应 compose volumes：- /volume1/xsai:/mnt/nas
# 说明：列目录只读、仅管理员，且只列目录不列文件；不影响「storage_root + relative_path」落盘红线。

# 账号体检间隔（分钟），0 关闭
PLATFORM_ACCOUNT_CHECK_INTERVAL=15

# 凭证加密密钥（生产首选）：base64 编码的 32 字节
# 生成：python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# 优先级：本变量 > PLATFORM_CREDENTIAL_KEY_FILE > data/secret.key(开发兜底)
PLATFORM_CREDENTIAL_ENC_KEY=
# 密钥文件路径；留空即视为未配置（勿写成空值赋值，否则会被当成 Path('.')）
# PLATFORM_CREDENTIAL_KEY_FILE=

# worker / 转录（Docker 下会传入 platform-worker）
PLATFORM_WORKER_CONCURRENCY=2
PLATFORM_WHISPER_MODEL=base
PLATFORM_WHISPER_DEVICE=auto
PLATFORM_WHISPER_COMPUTE_TYPE=int8
PLATFORM_DOWNLOAD_MIN_GAP_SECONDS=4
PLATFORM_DOWNLOAD_JITTER_SECONDS=6
PLATFORM_SUBSCRIPTION_SCAN_INTERVAL=5
PLATFORM_QR_SESSION_TTL=300
PLATFORM_QR_BROWSER_ENGINE=auto
# PLATFORM_RATE_LIMIT_PER_MINUTE=12

# 旧版 LLM 配置（仅用于首次启动认领到「模型接入」；可留空）
PLATFORM_LLM_BASE_URL=
PLATFORM_LLM_API_KEY=
PLATFORM_LLM_MODEL=

# 关键词采集（P5）：单次抓取超时（全部平台已原生，不再需要 MediaCrawler 目录）
PLATFORM_CRAWL_TIMEOUT_SECONDS=600

# 出站代理（可选，默认关闭）。单机自用通常直连即可；需要隔离出口 IP 时再配。
# 全局代理（HTTP 抓取 / 受管浏览器 / 扫码都会走它）
PLATFORM_OUTBOUND_PROXY=
# 按平台覆盖，JSON；值 "none" 表示该平台强制直连
# PLATFORM_PLATFORM_PROXIES={"douyin":"http://user:pass@host:port","bilibili":"none"}
